rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validTrialStartOnCreate() {
        return !('trialStartedAt' in request.resource.data)
          || request.resource.data.trialStartedAt == request.time;
      }

      function validTrialCheckOnCreate() {
        return !('trialCheckedAt' in request.resource.data)
          || request.resource.data.trialCheckedAt == request.time;
      }

      function validTrialLockOnCreate() {
        return !('trialLockedAt' in request.resource.data)
          || request.resource.data.trialLockedAt == request.time;
      }

      function trialStartIsImmutable() {
        return (
          !('trialStartedAt' in resource.data)
          && (
            !('trialStartedAt' in request.resource.data)
            || request.resource.data.trialStartedAt == request.time
          )
        ) || (
          'trialStartedAt' in resource.data
          && request.resource.data.trialStartedAt == resource.data.trialStartedAt
        );
      }

      function trialCheckIsServerTimeOrUnchanged() {
        return !('trialCheckedAt' in request.resource.data)
          || request.resource.data.trialCheckedAt == request.time
          || (
            'trialCheckedAt' in resource.data
            && request.resource.data.trialCheckedAt == resource.data.trialCheckedAt
          );
      }

      function trialLockIsImmutable() {
        return (
          !('trialLockedAt' in resource.data)
          && (
            !('trialLockedAt' in request.resource.data)
            || request.resource.data.trialLockedAt == request.time
          )
        ) || (
          'trialLockedAt' in resource.data
          && request.resource.data.trialLockedAt == resource.data.trialLockedAt
        );
      }

      function backendFieldsAreUnchanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'app', 'uid', 'email', 'displayName', 'emailVerified', 'providers',
          'photoUrl', 'createdAtMillis', 'lastSignInAt', 'lastSignInAtMillis',
          'lastSyncedAt', 'trialCheckedAt', 'trialLockedAt'
        ]);
      }

      function noClientEntitlementOnCreate() {
        return !request.resource.data.keys().hasAny([
          'isPremium', 'premium', 'premiumVerified', 'entitlement',
          'purchaseToken', 'purchaseOrderId', 'trialStartedAtMillis',
          'trialEndsAtMillis'
        ]);
      }

      allow read: if ownsProfile();
      allow create: if ownsProfile()
        && noClientEntitlementOnCreate()
        && validTrialStartOnCreate()
        && validTrialCheckOnCreate()
        && validTrialLockOnCreate();
      allow update: if ownsProfile()
        && backendFieldsAreUnchanged()
        && trialStartIsImmutable()
        && trialCheckIsServerTimeOrUnchanged()
        && trialLockIsImmutable();
      allow delete: if false;
    }

    // Quotas, entitlement overrides, and aggregate usage are maintained by Cloud Functions/Admin SDK.
    match /aiDailyUsage/{usageId} {
      allow read, write: if false;
    }

    match /aiEntitlements/{userId} {
      allow read, write: if false;
    }

    match /emailDailyUsage/{usageId} {
      allow read, write: if false;
    }

    // Purchase tokens and entitlement lifecycle are server-only.
    match /playPurchases/{purchaseTokenHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
