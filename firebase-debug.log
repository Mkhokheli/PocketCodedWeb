[debug] [2026-10-27T13:32:36.836Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/pocketcodedweb-6887b/rulesets {"name":"projects/pocketcodedweb-6887b/rulesets/a343c70d-c713-4116-a30d-25d01ceb0068","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    match /users/{userId} {\r\n      function ownsProfile() {\r\n        return request.auth != null && request.auth.uid == userId;\r\n      }\r\n\r\n      function validTrialStartOnCreate() {\r\n        return !('trialStartedAt' in request.resource.data)\r\n          || request.resource.data.trialStartedAt == request.time;\r\n      }\r\n\r\n      function validTrialCheckOnCreate() {\r\n        return !('trialCheckedAt' in request.resource.data)\r\n          || request.resource.data.trialCheckedAt == request.time;\r\n      }\r\n\r\n      function validTrialLockOnCreate() {\r\n        return !('trialLockedAt' in request.resource.data)\r\n          || request.resource.data.trialLockedAt == request.time;\r\n      }\r\n\r\n      function trialStartIsImmutable() {\r\n        return (\r\n          !('trialStartedAt' in resource.data)\r\n          && (\r\n            !('trialStartedAt' in request.resource.data)\r\n            || request.resource.data.trialStartedAt == request.time\r\n          )\r\n        ) || (\r\n          'trialStartedAt' in resource.data\r\n          && request.resource.data.trialStartedAt == resource.data.trialStartedAt\r\n        );\r\n      }\r\n\r\n      function trialCheckIsServerTimeOrUnchanged() {\r\n        return !('trialCheckedAt' in request.resource.data)\r\n          || request.resource.data.trialCheckedAt == request.time\r\n          || (\r\n            'trialCheckedAt' in resource.data\r\n            && request.resource.data.trialCheckedAt == resource.data.trialCheckedAt\r\n          );\r\n      }\r\n\r\n      function trialLockIsImmutable() {\r\n        return (\r\n          !('trialLockedAt' in resource.data)\r\n          && (\r\n            !('trialLockedAt' in request.resource.data)\r\n            || request.resource.data.trialLockedAt == request.time\r\n          )\r\n        ) || (\r\n          'trialLockedAt' in resource.data\r\n          && request.resource.data.trialLockedAt == resource.data.trialLockedAt\r\n        );\r\n      }\r\n\r\n      function backendFieldsAreUnchanged() {\r\n        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'app', 'uid', 'email', 'displayName', 'emailVerified', 'providers',\r\n          'photoUrl', 'createdAtMillis', 'lastSignInAt', 'lastSignInAtMillis',\r\n          'lastSyncedAt', 'trialCheckedAt', 'trialLockedAt'\r\n        ]);\r\n      }\r\n\r\n      function noClientEntitlementOnCreate() {\r\n        return !request.resource.data.keys().hasAny([\r\n          'isPremium', 'premium', 'premiumVerified', 'entitlement',\r\n          'purchaseToken', 'purchaseOrderId', 'premiumProductId',\r\n          'premiumPurchaseTokenHash', 'premiumVerifiedAt', 'premiumRevokedAt',\r\n          'lifetimePremium',\r\n          'monthlyExpiresAt',\r\n          'monthlyPurchaseTokenHash',\r\n          'purchaseTokenHash', 'orderId', 'active', 'verifiedAt', 'voidedAt',\r\n          'revokedAt', 'acknowledgementState', 'acknowledgementPending',\r\n          'trialStartedAtMillis', 'trialEndsAtMillis'\r\n        ]);\r\n      }\r\n\r\n      function profileUidMatchesPath() {\r\n        return !('uid' in request.resource.data) || request.resource.data.uid == userId;\r\n      }\r\n\r\n      allow read: if ownsProfile();\r\n      allow create: if ownsProfile()\r\n        && profileUidMatchesPath()\r\n        && noClientEntitlementOnCreate()\r\n        && validTrialStartOnCreate()\r\n        && validTrialCheckOnCreate()\r\n        && validTrialLockOnCreate();\r\n      allow update: if ownsProfile()\r\n        && profileUidMatchesPath()\r\n        && backendFieldsAreUnchanged()\r\n        && trialStartIsImmutable()\r\n        && trialCheckIsServerTimeOrUnchanged()\r\n        && trialLockIsImmutable();\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Quotas, entitlement overrides, and aggregate usage are maintained by Cloud Functions/Admin SDK.\r\n    match /aiDailyUsage/{usageId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /aiEntitlements/{userId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /emailDailyUsage/{usageId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // Purchase tokens and entitlement lifecycle are server-only.\r\n    match /playPurchases/{purchaseTokenHash} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-27T13:32:36.150559Z","metadata":{"services":["cloud.firestore"]}}
